# General
ENV=development
LOG_LEVEL=INFO
PARSER_VERSION=2026.04.24
AUTO_SEED_DATA=true
AUTO_CREATE_SCHEMA=true
API_BASE_PATH=/api/v1

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
ADMIN_API_TOKEN=dev-admin-token
ADMIN_ALLOWED_EMAILS=admin@apfinance.local

# Official data source endpoints (override with document URLs)
RBI_SOURCE_URL=https://rbi.org.in/
AP_FINANCE_SOURCE_URL=https://finance.ap.gov.in/
CAG_SOURCE_URL=https://cag.gov.in/

# Database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=public_finance
POSTGRES_USER=public_finance
POSTGRES_PASSWORD=public_finance
DATABASE_URL=postgresql+psycopg://public_finance:public_finance@postgres:5432/public_finance

# Redis (Celery broker/result backend)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# S3-compatible object storage (MinIO in local compose)
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=public-finance-data
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_USE_SSL=false

# MinIO local admin
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# Next.js
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
